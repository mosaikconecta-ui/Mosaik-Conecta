# ───────────── Obrigatórias ─────────────
# PostgreSQL 14+ (local, Neon, Supabase, RDS…)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mosaik?schema=public"
# URL pública da loja, sem barra no final (usada em e-mails, webhooks, SEO e links de pagamento)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Exibe a faixa "Ambiente de demonstração". Use "false" ao operar com produtos reais.
NEXT_PUBLIC_DEMO_MODE="true"

# Usuário administrador criado pelo seed (npm run db:seed). Sem senha definida, uma aleatória é gerada e exibida no console.
SEED_ADMIN_EMAIL="admin@mosaik.example"
SEED_ADMIN_PASSWORD=""

# Pasta persistente para imagens enviadas pelo painel (padrão: ./storage/uploads)
UPLOAD_DIR=""

# ───────────── Pagamentos — Mercado Pago (Checkout Pro) ─────────────
# Desenvolvimento: use a credencial de TESTE (começa com TEST-) ou o Access Token de um usuário de teste.
MERCADOPAGO_ACCESS_TOKEN=""
# Chave secreta do webhook (Suas integrações → Webhooks → Assinatura secreta). Sem ela, todo webhook é rejeitado.
MERCADOPAGO_WEBHOOK_SECRET=""
# Parcelamento máximo oferecido no Mercado Pago
MERCADOPAGO_MAX_INSTALLMENTS="6"
# "true" força o link sandbox_init_point (útil com Access Token de usuário de teste APP_USR-…)
MERCADOPAGO_USE_SANDBOX_URL=""

# ───────────── E-mail transacional — Resend ─────────────
RESEND_API_KEY=""
EMAIL_FROM="Mosaik <pedidos@seudominio.com.br>"

# ───────────── Marketing e atendimento ─────────────
NEXT_PUBLIC_GA4_ID=""            # G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""     # somente números
NEXT_PUBLIC_WHATSAPP_NUMBER=""   # DDI+DDD+número, ex.: 5511999999999

# ───────────── Tarefas agendadas ─────────────
# Protege GET /api/cron (carrinho abandonado, cancelamento de pedidos não pagos, limpeza)
CRON_SECRET=""

# ───────────── Fornecedores (preparado, ainda não ativo) ─────────────
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_ACCESS_TOKEN=""
CJ_API_KEY=""
