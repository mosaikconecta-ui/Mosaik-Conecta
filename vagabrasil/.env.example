# ============================================================
# VagaBrasil — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure na Vercel.
# ============================================================

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha no navegador. Usada apenas no servidor (webhooks, admin, URLs assinadas).
SUPABASE_SERVICE_ROLE_KEY=

# Pagamentos: "development" (sem cobranças reais) ou "production" (Mercado Pago)
PAYMENTS_MODE=development
# Mercado Pago (Suas integrações → Credenciais). Use credenciais de TESTE em homologação.
MERCADOPAGO_ACCESS_TOKEN=
# Webhooks → Assinatura secreta
MERCADOPAGO_WEBHOOK_SECRET=

# Resend (e-mails transacionais). Sem a chave, os e-mails são apenas registrados no log.
RESEND_API_KEY=
EMAIL_FROM="VagaBrasil <nao-responda@vagabrasil.com.br>"

# Segredo para as rotas de cron (Vercel Cron envia como Bearer token)
CRON_SECRET=
